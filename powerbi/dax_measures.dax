// ============================================================================
// Power BI DAX Measures - Personal Expense Tracker & Budget Dashboard
// Applied to table: cleaned_transactions
// Relationship: budget_targets[budget_month] (1) -> cleaned_transactions[year_month] (*)
// ============================================================================

Total Income =
CALCULATE(
    SUM(cleaned_transactions[amount]),
    cleaned_transactions[type] = "Income"
)

Total Expenses =
CALCULATE(
    SUM(cleaned_transactions[amount]),
    cleaned_transactions[type] = "Expense"
)

Total Savings =
[Total Income] - [Total Expenses]

Savings Rate % =
DIVIDE([Total Savings], [Total Income], 0)

Monthly Budget =
AVERAGE(budget_targets[budget_limit])

Budget Variance =
SUMX(
    VALUES(budget_targets[budget_month]),
    CALCULATE(MAX(budget_targets[budget_limit]))
) - [Total Expenses]

Budget Utilization % =
DIVIDE(
    [Total Expenses],
    SUMX(
        VALUES(budget_targets[budget_month]),
        CALCULATE(MAX(budget_targets[budget_limit]))
    ),
    0
)

Budget Status =
VAR PeriodBudget =
    SUMX(
        VALUES(budget_targets[budget_month]),
        CALCULATE(MAX(budget_targets[budget_limit]))
    )
VAR Ratio = DIVIDE([Total Expenses], PeriodBudget, 0)
RETURN
IF(
    [Total Expenses] > PeriodBudget,
    "Exceeded",
    IF(Ratio >= 0.80, "Near Limit", "Within Budget")
)
